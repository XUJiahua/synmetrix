NODE_ENV=development
SERVER_URL=http://localhost
REDIRECT_URL_SUCCESS=http://localhost/callback
REDIRECT_URL_ERROR=http://localhost/callback
APP_FRONTEND_URL=http://client

POSTGRES_PASSWORD=pg_pass

JWK_URL=http://keycloak:8080/realms/hasura-app/protocol/openid-connect/certs
HASURA_GRAPHQL_JWT_SECRET={"jwk_url": "${JWK_URL}"}
JWT_CLAIMS_NAMESPACE=https://hasura.io/jwt/claims
HASURA_GRAPHQL_ADMIN_SECRET=devsecret
## postgres database to store Hasura metadata
HASURA_GRAPHQL_METADATA_DATABASE_URL=postgres://postgres:${POSTGRES_PASSWORD}@postgres:5432/hasura_metadata
## this env var can be used to add the above postgres database to Hasura as a data source. this can be removed/updated based on your needs
PG_DATABASE_URL=postgres://postgres:${POSTGRES_PASSWORD}@postgres:5432/hasura

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# go actions
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=hasura-app
KEYCLOAK_CLIENT_ID=hasura-sync-service

# Keycloak Authentication Method 1: Client Credentials (Service Account) - RECOMMENDED
# Use this for production environments
KEYCLOAK_CLIENT_SECRET=jVz7FBm5GKpSQERqOyyADrZ1loQ5lF47

# Keycloak Authentication Method 2: Admin User Credentials - FOR DEVELOPMENT ONLY
# Uncomment these lines to use admin username/password authentication instead
#KEYCLOAK_ADMIN_USERNAME=admin
#KEYCLOAK_ADMIN_PASSWORD=admin

# let hasura container aware of
GO_ACTIONS_URL=http://go-actions:3000

# for agents
# Model Configuration
# MODEL_PROVIDER=openailike
MODEL_PROVIDER=deepseek

# DeepSeek Configuration
DEEPSEEK_API_KEY=sk-2d73d0b174fe480ab30e682e085aa810
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# CubeJS Configuration
CUBEJS_URL=http://cubejs:4000

# Debug Configuration
# Enable debug mode to capture all agent-LLM interactions
# Set to "true" to enable debug logging in terminal
AGNO_DEBUG=true

# HTTP Request Logging
# Set to DEBUG to see full HTTP requests/responses to LLM providers
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=DEBUG
# LOG_TO_FILE=true

JWT_ENABLED=true
JWT_TOKEN_SOURCE=HEADER
JWT_JWKS_URL=http://keycloak:8080/realms/hasura-app/protocol/openid-connect/certs
JWT_DEPENDENCIES_CLAIMS=["https://hasura.io/jwt/claims"]
JWT_SESSION_STATE_CLAIMS=["name"]


HASURA_GRAPHQL_ENDPOINT=http://hasura:8080/v1/graphql

# Database Configuration
# Options: sqlite, postgres
DB_BACKEND=postgres
POSTGRES_DB_URL=postgresql+psycopg://postgres:${POSTGRES_PASSWORD}@postgres:5432/agents
# Optional schema override (defaults to "ai" in Agno)
POSTGRES_DB_SCHEMA=ai