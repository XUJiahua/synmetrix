# Server Configuration
SERVER_PORT=3000

# Keycloak Configuration
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=synmetrix
KEYCLOAK_CLIENT_ID=hasura-sync-service

# Keycloak Authentication Method 1: Client Credentials (Service Account) - RECOMMENDED
# Use this for production environments
KEYCLOAK_CLIENT_SECRET=your-client-secret-here

# Keycloak Authentication Method 2: Admin User Credentials - FOR DEVELOPMENT ONLY
# Uncomment these lines to use admin username/password authentication instead
# KEYCLOAK_ADMIN_USERNAME=admin
# KEYCLOAK_ADMIN_PASSWORD=admin-password

# Note: You must provide either KEYCLOAK_CLIENT_SECRET or both KEYCLOAK_ADMIN_USERNAME and KEYCLOAK_ADMIN_PASSWORD
# If both are provided, admin user authentication takes precedence

# Hasura Configuration
HASURA_ENDPOINT=http://hasura:8080/v1/graphql
HASURA_ADMIN_SECRET=your-hasura-admin-secret

# JWT Configuration (optional, only if JWT validation is needed)
JWT_SECRET=your-jwt-secret
JWT_CLAIMS_NAMESPACE=https://hasura.io/jwt/claims
